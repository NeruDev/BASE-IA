# Configuración local de las bases teóricas externas (plantilla: config/external-bases.example)
config/external-bases.local

# Variables de entorno locales y secretos
.env
.env.*

# Archivos del sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Entorno virtual de Python (ADR-0003)
.venv/
__pycache__/

# Editor: solo se versionan las tareas y exclusiones compartidas
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json

# Biblioteca de chequeos: neutraliza lib/ si la plantilla vive en un repo Python
!/scripts/lib/

# Trabajo efímero: únicamente los dos archivos de control se versionan
/sandbox/*
!/sandbox/README.md
!/sandbox/.gitkeep
