{
  "$schema": "../../schemas/manifest.schema.json",
  "id": "profile_library_sdk",
  "name": "library_sdk",
  "title": "Perfil para Bibliotecas y SDKs Reutilizables",
  "version": "2.0.0",
  "schema_version": "1.0.0",
  "description": "Configuración enfocada en contratos de API pública, empaquetado, pruebas exhaustivas y compatibilidad SemVer.",
  "owner": "AI Engineering & Architecture Team",
  "created_at": "2026-08-29T21:00:00Z",
  "updated_at": "2026-08-29T21:00:00Z",
  "profile_config": {
    "id": "library_sdk",
    "name": "Library SDK Profile",
