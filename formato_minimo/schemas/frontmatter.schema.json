{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NeruDev/BASE-IA/main/formato_minimo/schemas/frontmatter.schema.json",
  "title": "YAML Frontmatter Schema",
  "description": "Validation schema for YAML Frontmatter metadata headers across all Markdown files in BASE-IA.",
  "type": "object",
  "required": [
    "id",
    "name",
    "title",
    "file_path",
    "version",
    "category",
    "tags",
    "description",
    "owner",
    "status",
    "created_at",
    "updated_at",
    "schema_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,12}_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Unique immutable TypeID (e.g., tmpl_..., doc_..., spec_..., bp_...)"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,64}$",
      "description": "Unique identifier in snake_case matching basename"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 150,
      "description": "Human-readable title"
    },
    "file_path": {
      "type": "string",
      "description": "Relative POSIX file path from repository root"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer 2.0.0 string"
    },
    "category": {
      "type": "string",
      "enum": [
        "standards",
        "architecture",
        "agentic",
        "code_standards",
        "metadata",
        "errors",
        "templates",
        "guides",
        "universal_principles",
        "architecture_plan",
        "memory",
        "governance",
        "testing",
        "ci",
        "security"
      ],
      "description": "Global taxonomic category"
    },
    "domain": {
      "type": "string",
      "description": "Functional domain (e.g. core, devops, iot, ml, web)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "minItems": 1,
      "maxItems": 30,
      "description": "Lower-case keywords for indexing and discovery"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Concise summary of document contents and scope"
    },
    "author": {
      "type": "string",
      "description": "Original author"
    },
    "owner": {
      "type": "string",
      "description": "Responsible team or role"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of active maintainers"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "ready_for_execution", "deprecated", "archived"],
      "description": "Lifecycle status"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema specification version"
    },
    "license": {
      "type": "string",
      "description": "SPDX License identifier"
    },
    "agent_visibility": {
      "type": "string",
      "enum": ["public", "internal", "restricted"],
      "default": "public"
    },
    "tool_access_level": {
      "type": "string",
      "enum": ["read_only", "safe_mutation", "full_access"],
      "default": "safe_mutation"
    },
    "execution_mode": {
      "type": "string",
      "enum": ["sync", "async", "batch", "event_driven"]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_specs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
